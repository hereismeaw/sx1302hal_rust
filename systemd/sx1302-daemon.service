[Unit]
Description=Native Rust SX1302 GWMP forwarder (AS923-1) -> ChirpStack
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
# Daemon pings every WatchdogSec/2 only while SPI + 32 MHz counter are healthy.
WatchdogSec=30
TimeoutStartSec=60
# GPIO reset (gpiochip0 / pinctrl) + /dev/spidev0.0 need root on this image.
User=root
EnvironmentFile=-/etc/default/sx1302-daemon
ExecStart=/usr/local/bin/sx1302-daemon --config /etc/sx1302-daemon.json --server ${SX1302_SERVER}
Restart=always
RestartSec=5
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
